# Redirects for SMS site migration from /en/ and /fr/ directories to unified pages
# This file follows Netlify/Cloudflare Pages redirect syntax
# 301 = permanent redirect (important for SEO)

# Redirect old language directories to root
/en/                    /                       301
/fr/                    /                       301
/en                     /                       301
/fr                     /                       301

# Redirect about pages
/en/about.html          /about.html             301
/fr/about.html          /about.html             301

# Redirect search pages (note: /fr/recherche.html now becomes /search.html)
/en/search.html         /search.html            301
/fr/recherche.html      /search.html            301

# Default redirect for any other /en/ or /fr/ paths (catch-all)
/en/*                   /:splat                 301
/fr/*                   /:splat                 301
